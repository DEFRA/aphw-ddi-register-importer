{
  "name": "aphw-ddi-register-importer",
  "version": "0.9.0",
  "description": "Worker service to process DDI register import requests",
  "homepage": "https://github.com/DEFRA/aphw-ddi-register-importer",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/data-tables": "^13.2.2",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.17.0",
    "@hapi/hapi": "^21.4.10",
    "@hapi/wreck": "^18.1.0",
    "@joi/date": "^2.1.0",
    "applicationinsights": "^3.16.0",
    "date-fns": "^3.2.0",
    "ffc-messaging": "^2.10.10",
    "joi": "^17.13.8",
    "log-timestamp": "^0.3.0",
    "read-excel-file": "^5.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "overrides": {
    "uuid": "$uuid"
  }
}